{
  "name": "currency-rate-alert-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Scheduled live-rate retrieval, validation, target comparison, and multi-channel notifications (Email/Telegram/Push) for the MY Currency Rate Tracker app. v1.0.0 — see the repo root CHANGELOG.md for what's included.",
  "main": "index.js",
  "scripts": {
    "test": "cd .. && node --test",
    "check:mymoneymaster": "node scripts/checkRate.js mymoneymaster CNY",
    "check:tajmuhabath": "node scripts/checkRate.js tajmuhabath CNY \"LALAPORT BBCC\"",
    "check:merchantradeasia": "node scripts/checkRate.js merchantradeasia CNY",
    "check:jalinanduta": "node scripts/checkRate.js jalinanduta CNY",
    "scheduler": "node scheduler/run.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "playwright": "^1.47.0",
    "@supabase/supabase-js": "^2.45.0",
    "web-push": "^3.6.7"
  }
}
