# Copy this file to .env for local backend development, and add the same
# names as encrypted secrets in GitHub Actions (Settings > Secrets and
# variables > Actions) for the scheduled workflow. NEVER commit a real .env
# file, and NEVER put any of these values in frontend/ code — the frontend
# only ever uses SUPABASE_ANON_KEY, which is safe to expose because access
# is enforced by Postgres Row-Level Security, not by keeping it secret.

# --- Supabase (Phase 7) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=            # safe for the frontend
SUPABASE_SERVICE_ROLE_KEY=    # backend / GitHub Actions ONLY — full write access

# --- Email notifications (Phase 10) ---
RESEND_API_KEY=

# --- Telegram notifications (Phase 10) ---
TELEGRAM_BOT_TOKEN=

# --- Monitoring behavior ---
DEFAULT_MONITORING_INTERVAL_MINUTES=5
