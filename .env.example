# Copy this file to .env for local backend development, and add the same
# names as encrypted secrets in GitHub Actions (Settings > Secrets and
# variables > Actions) for the scheduled workflow. NEVER commit a real .env
# file, and NEVER put any of these values in frontend/ code — the frontend
# only ever uses SUPABASE_ANON_KEY, which is safe to expose because access
# is enforced by Postgres Row-Level Security, not by keeping it secret.

# --- Supabase (Phase 7) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=            # safe for the frontend
SUPABASE_SERVICE_ROLE_KEY=    # backend / GitHub Actions ONLY — full write access

# --- Email notifications (Phase 10) ---
RESEND_API_KEY=

# --- Telegram notifications (Phase 10) ---
TELEGRAM_BOT_TOKEN=

# --- Web Push notifications (Phase 39) ---
# Generate with `npx web-push generate-vapid-keys`. VAPID_PUBLIC_KEY is also,
# separately and intentionally, placed in frontend/pushConfig.js — it is not
# a secret (it's how a browser verifies which server may push to a
# subscription), unlike VAPID_PRIVATE_KEY, which must only ever live here /
# as a GitHub Actions secret. See PUSH_SETUP.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                # mailto: or https: URL, e.g. mailto:you@example.com

# --- App URL (used as the click-through link in push notifications) ---
# Optional — defaults to this project's actual GitHub Pages URL in
# backend/notifications/notify.js if unset. Only set this if you've forked
# or redeployed the frontend somewhere else.
APP_URL=

# --- Monitoring behavior ---
DEFAULT_MONITORING_INTERVAL_MINUTES=5
